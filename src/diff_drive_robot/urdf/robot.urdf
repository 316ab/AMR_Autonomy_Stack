<?xml version="1.0"?>
<robot name="diff_drive_robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:include filename="$(find diff_drive_robot)/urdf/robot.gazebo" />

    <xacro:include filename="inertial_macros.xacro" />

    <xacro:property name="drive_wheel_radius" value="0.1016" />
    <xacro:property name="drive_wheel_width" value="0.04" />
    <xacro:property name="caster_wheel_radius" value="0.04" />
    <xacro:property name="chassis_length" value="0.758" />
    <xacro:property name="chassis_width" value="0.508" />
    <xacro:property name="chassis_height" value="0.245" />
    <xacro:property name="chassis_z_offset" value="${112/1000 - drive_wheel_radius + chassis_height/2}" /> 

        <xacro:property name="chassis_top_z" value="0.1975"/>
    <xacro:property name="rod_len" value="0.15"/>          <!-- 150 mm -->
    <xacro:property name="rod_radius" value="0.007"/>      <!-- Ø10 mm -->
    <xacro:property name="plate_x" value="0.25"/>          <!-- 250 mm -->
    <xacro:property name="plate_y" value="0.25"/>          <!-- 250 mm -->
    <xacro:property name="plate_z" value="0.005"/>         <!-- 5 mm -->
    <!-- Place rod center at chassis top + half rod -->
    <xacro:property name="rod_center_z" value="${chassis_top_z + rod_len/2.0}"/>
    <!-- Keep the plate’s **bottom face** exactly 150 mm above chassis top:
         plate center = chassis_top_z + 0.150 + plate_z/2 = chassis_top_z + 0.150 + 0.0025 -->
    <xacro:property name="plate_center_z_rel_to_rod_center" value="${(rod_len/2.0) + (plate_z/2.0)}"/>

 <link name="base_link">

  </link>

    <joint name="chassis_joint" type="fixed">
        <parent link="base_link"/>
        <child link="chassis"/>
        <origin xyz="0 0 0.112"/> 
    </joint>

    <link name="chassis">
        <visual>
            <origin xyz="0 0 ${chassis_z_offset}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
            <material name="chassis_material">
                <color rgba="0.905 0.192 0.0627 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 ${chassis_z_offset}"/>
            <geometry>
                <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
            </geometry>
        </collision>
        <xacro:inertial_box mass="15.0" x="${chassis_length}" y="${chassis_width}" z="${chassis_height}">
            <origin xyz="0 0 ${chassis_z_offset}" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="0 0.106 ${drive_wheel_radius}" rpy="-${pi/2} 0 0"/>
        <child link="left_wheel"/>
        <parent link="base_link"/>
        <axis xyz="0 0 1"/>
    </joint>

    <link name="left_wheel">
        <xacro:inertial_cylinder mass="0.5" length="${drive_wheel_width}" radius="${drive_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
        <collision>
            <geometry>
                <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
            </geometry>
        </collision>
        <visual>
            <geometry>
               <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
            </geometry>
            <material name="wheel_material">
               <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
    </link>

    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="0 -0.106 ${drive_wheel_radius}" rpy="${pi/2} 0 0"/>
        <child link="right_wheel"/>
        <parent link="base_link"/>
        <axis xyz="0 0 -1"/>
    </joint>

    <link name="right_wheel">
        <xacro:inertial_cylinder mass="0.5" length="${drive_wheel_width}" radius="${drive_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
        <visual>
            <geometry>
                <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
            </geometry>
            <material name="wheel_material">
                <color rgba="0.0 0.0 0.0 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${drive_wheel_radius}" length="${drive_wheel_width}"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_left_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_left_caster"/>
        <origin xyz="0.294 0.194 ${caster_wheel_radius}"/>
    </joint>

    <link name="front_left_caster">
        <xacro:inertial_sphere mass="0.2" radius="${caster_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
        </collision>
    </link>

    <joint name="front_right_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="front_right_caster"/>
        <origin xyz="0.294 -0.194 ${caster_wheel_radius}"/>
    </joint>

    <link name="front_right_caster">
        <xacro:inertial_sphere mass="0.2" radius="${caster_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
        </collision>
    </link>

    <joint name="back_left_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="back_left_caster"/>
        <origin xyz="-0.294 0.194 ${caster_wheel_radius}"/>
    </joint>

    <link name="back_left_caster">
        <xacro:inertial_sphere mass="0.2" radius="${caster_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
        </collision>
    </link>

    <joint name="back_right_caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="back_right_caster"/>
        <origin xyz="-0.294 -0.194 ${caster_wheel_radius}"/>
    </joint>

    <link name="back_right_caster">
        <xacro:inertial_sphere mass="0.2" radius="${caster_wheel_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_sphere>
        <visual>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
            <material name="castor_material">
                <color rgba="0.62 0.62 0.62 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <sphere radius="${caster_wheel_radius}"/>
            </geometry>
        </collision>
    </link>
  
    <!-- === Vertical rod fixed to chassis top center === -->
    <joint name="mast_rod_joint" type="fixed">
        <parent link="chassis"/>
        <!-- If your chassis frame is at its geometric center in x,y, keep 0 0; otherwise offset accordingly -->
        <child link="mast_rod"/>
        <origin xyz="0 0 ${rod_center_z}" rpy="0 0 0"/>
    </joint>

    <link name="mast_rod">
        <!-- Using your inertial macros -->
        <xacro:inertial_cylinder mass="0.2" length="${rod_len}" radius="${rod_radius}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
        <visual>
            <geometry>
                <cylinder radius="${rod_radius}" length="${rod_len}"/>
            </geometry>
            <material name="rod_material">
                <color rgba="0.2 0.2 0.2 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="${rod_radius}" length="${rod_len}"/>
            </geometry>
        </collision>
    </link>

    <!-- === Top plate fixed above the rod === -->
    <joint name="top_plate_joint" type="fixed">
        <parent link="mast_rod"/>
        <!-- plate center is 0.0775 m above the rod center (0.150/2 + 0.005/2) -->
        <child link="top_plate"/>
        <origin xyz="0 0 ${plate_center_z_rel_to_rod_center}" rpy="0 0 0"/>
    </joint>

    <link name="top_plate">
        <xacro:inertial_box mass="1.0" x="${plate_x}" y="${plate_y}" z="${plate_z}">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
        <visual>
            <geometry>
                <box size="${plate_x} ${plate_y} ${plate_z}"/>
            </geometry>
            <material name="plate_material">
                <color rgba="0.65 0.25 0.65 1.0"/>
            </material>
        </visual>
        <collision>
            <geometry>
                <box size="${plate_x} ${plate_y} ${plate_z}"/>
            </geometry>
        </collision>
    </link>
    <gazebo reference="left_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="right_wheel">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="front_left_caster">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>
    <gazebo reference="front_right_caster">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>
    <gazebo reference="back_left_caster">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>
    <gazebo reference="back_right_caster">
        <mu1>0.001</mu1>
        <mu2>0.001</mu2>
    </gazebo>

    <gazebo reference="chassis">
        <mu1>0.8</mu1>
        <mu2>0.8</mu2>
    </gazebo>

    <!-- Lidar Sensor -->
    <joint name="laser_joint" type="fixed">
        <parent link="chassis"/>
        <child link="laser_frame"/>
        <origin xyz="0.377 0 0.252" rpy="0 0 0"/>
    </joint>
    <link name="laser_frame">
        <visual>
            <origin xyz="0 0 0"/>
            <geometry>
            <cylinder length="0.04" radius="0.05"/>
            </geometry>
            <material name="laser_material">
            <color rgba="0.13 0.13 0.13 1.0"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0"/>
            <geometry>
            <cylinder length="0.04" radius="0.05"/>
            </geometry>
        </collision>
        <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <!-- IMU Sensor -->
    <joint name="imu_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0 0 0" />
        <parent link="base_link"/>
        <child link="imu_link" />
    </joint>

    <link name="imu_link" />
</robot>